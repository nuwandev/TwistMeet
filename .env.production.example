# Copy to .env.production and fill in real values for your target environment. NEVER commit
# .env.production (already covered by .gitignore's `.env.*` rule) — these are real secrets and a
# real public URL, not placeholders to leave in source control.
#
# See DEPLOYMENT.md for what each value means operationally and docker-compose.production.yml
# for how they're consumed.

# --- Database (externally managed Postgres — not started by this compose file) ---
# Use a DIRECT (non-pooled) connection string. Flyway's migration run at API startup needs
# session state/advisory locks that don't survive a transaction-mode connection pooler (e.g.
# Neon's `-pooler` host, PgBouncer). See DEPLOYMENT.md "Neon direct vs. pooled connections" if
# you later want the running app itself on a pooled connection for higher concurrency — that is
# a separate setting from this one, which Flyway/every request currently share.
TWISTMEET_DB_URL=jdbc:postgresql://YOUR-DB-HOST:5432/twistmeet
TWISTMEET_DB_USER=CHANGE_ME
TWISTMEET_DB_PASSWORD=CHANGE_ME

# --- Mail (externally managed provider — not started by this compose file) ---
# A real SMTP provider (SES, Postmark, Sendgrid, etc.) that supports STARTTLS/auth. The API's
# SmtpMailService swallows send failures rather than breaking registration (see DECISIONS.md),
# so a misconfigured provider fails silently into the logs, not into a user-facing error —
# check logs after first deploying, don't assume email is working.
TWISTMEET_MAIL_HOST=smtp.your-provider.example
TWISTMEET_MAIL_PORT=587
TWISTMEET_MAIL_FROM=no-reply@your-domain.example

# --- Cross-origin / CORS ---
# The web app's real public origin. Must exactly match what the browser sends as Origin, or
# every authenticated request will be rejected by CORS. See api/.../config/SecurityConfig.java.
TWISTMEET_WEB_BASE_URL=https://app.your-domain.example

# --- Scramble vault encryption ---
# A real, random key. ScrambleEncryptionService refuses to start under the production Spring
# profile without one (see DECISIONS.md "Production scramble-key fail-fast"). Generate with:
#   openssl rand -base64 32
# Store it in your platform's secret manager, not in this file once filled in for real.
TWISTMEET_SCRAMBLE_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND

# --- Web build args (baked into the client bundle at image-build time — see web/Dockerfile) ---
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example
NEXT_PUBLIC_APP_NAME=TwistMeet

# --- Image tagging (optional) ---
IMAGE_TAG=local
